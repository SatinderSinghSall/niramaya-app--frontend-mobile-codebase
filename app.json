{
  "expo": {
    "name": "Niramaya",
    "slug": "niramaya",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/main-app-icon.png",
    "scheme": "niramaya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "4",
      "icon": "./assets/images/main-app-icon.png"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/main-app-icon.png",
        "backgroundImage": "./assets/images/main-app-icon.png",
        "monochromeImage": "./assets/images/main-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.satinder_singh_sall.niramaya"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/main-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/main-app-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5f80bb1-37bf-442d-aef5-13eecd4f9eb9"
      }
    }
  }
}
